<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnyHttpProxy.GatewayApp.ViewModels"
        xmlns:ui="using:AnyHttpProxy.UI"
        x:Class="AnyHttpProxy.GatewayApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AnyHttpProxy Gateway"
        Width="900" Height="820"
        MinWidth="740" MinHeight="600"
        Background="{DynamicResource Bg}"
        FontFamily="Cascadia Mono, Consolas, monospace"
        FontSize="13">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <!-- Status bar -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="44" Margin="24,0">
      <TextBlock Grid.Column="0" Text="ahp gateway" FontSize="12.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Classes="k" FontSize="12" VerticalAlignment="Center" Text="{Binding HostsSummary}" />
    </Grid>
    <Border Grid.Row="0" Classes="sep" VerticalAlignment="Bottom" />

    <!-- Add host -->
    <Grid Grid.Row="1" Margin="24,18,24,16" ColumnDefinitions="170,16,*,16,Auto">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock Classes="k" Text="name" />
        <TextBox Text="{Binding NewName}" PlaceholderText="work pc" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock Classes="k" Text="invite code from AnyHttpProxy Host" />
        <TextBox Text="{Binding NewCode}" PlaceholderText="tc..." />
      </StackPanel>
      <Button Grid.Column="4" Classes="primary" Content="Add host" VerticalAlignment="Bottom"
              IsEnabled="{Binding NotAdding}" Click="OnAdd" />
    </Grid>
    <Border Grid.Row="1" Classes="sep" VerticalAlignment="Bottom" />

    <!-- Where ports listen + firewall -->
    <StackPanel Grid.Row="2" Margin="24,14,24,14" Spacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="k" Text="listen on" VerticalAlignment="Center" />
          <TextBlock Classes="val" FontSize="12" Text="{Binding NetworkSummary}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="2" Classes="quiet" Content="Change">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="520" Spacing="10" Margin="6">
                <RadioButton GroupName="listen" Content="All networks of this computer (0.0.0.0 and [::])"
                             IsChecked="{Binding AllNetworks}" />
                <RadioButton GroupName="listen" Content="Only the networks chosen below"
                             IsChecked="{Binding ChosenNetworks}" />
                <ItemsControl ItemsSource="{Binding Networks}" IsEnabled="{Binding ChosenNetworks}" Margin="26,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkRow">
                      <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" FontSize="12" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="ui" FontSize="12" Margin="26,0,0,0"
                           Text="localhost (127.0.0.1 and ::1) always listens, so this computer can use every port." />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="quiet" Content="Refresh list" Click="OnReloadNetworks" />
                  <Button Classes="primary" Content="Apply" IsEnabled="{Binding IsNetworkDirty}" Click="OnApplyNetworks" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <Border IsVisible="{Binding ShowFirewall}" BorderBrush="#4A3A22" BorderThickness="1" CornerRadius="3"
              Background="#1A1610" Padding="14,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="ui" FontSize="12.5" MaxWidth="600" Foreground="{DynamicResource Warn}"
                     Text="{Binding FirewallText}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Classes="quiet" Content="Check again" Click="OnCheckFirewall" IsEnabled="{Binding FirewallNotBusy}" />
            <Button Classes="primary" Content="Allow in firewall" Click="OnAllowFirewall" IsEnabled="{Binding FirewallNotBusy}"
                    IsVisible="{Binding CanAllowFirewall}"
                    ToolTip.Tip="Adds inbound rules for these ports (asks for admin rights)" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
    <Border Grid.Row="2" Classes="sep" VerticalAlignment="Bottom" />

    <!-- Hosts and their ports -->
    <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="24,16,24,0">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
        <TextBlock Grid.Column="0" Classes="k" Text="hosts" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="quiet" Content="Retry busy ports" Click="OnRetryConflicts"
                ToolTip.Tip="Try again to take ports that were in use" />
      </Grid>

      <TextBlock Grid.Row="1" Classes="ui" VerticalAlignment="Top" IsVisible="{Binding HasNoHosts}"
                 Text="No hosts yet. On the computer with the services, open AnyHttpProxy Host, click Invite gateway and paste the code above. You can add several hosts." />

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasHosts}" Padding="0,0,12,0">
        <ItemsControl ItemsSource="{Binding Hosts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HostRow">
              <Grid ColumnDefinitions="2,16,*" Margin="0,0,0,10">
                <Border Grid.Column="0" Background="{Binding StatusAccent}" CornerRadius="1" Margin="0,12,0,8" />

                <StackPanel Grid.Column="2">
                  <!-- Host header -->
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Height="46">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="k" FontSize="12" Margin="10,0,0,0" Text="{Binding Machine}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="k" FontSize="12" Margin="0,0,14,0" Text="{Binding MappingsSummary}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="12" Margin="0,0,10,0"
                               Foreground="{Binding StatusAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                      <Button Classes="quiet" Content="{Binding ToggleText}" Click="OnToggleHost" IsEnabled="{Binding NotBusy}" />
                      <Button Classes="quiet" Content="⋯" Width="34" ToolTip.Tip="More">
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Remove host" Click="OnRemoveHost" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <Border Classes="sep" />

                  <TextBlock Classes="ui" FontSize="12" Margin="0,10,0,4" IsVisible="{Binding HasNoMappings}"
                             Text="No services from this host yet. They show up once it connects and shares something." />

                  <!-- Port mappings -->
                  <ItemsControl ItemsSource="{Binding Mappings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MappingRow">
                        <StackPanel>
                          <Grid ColumnDefinitions="Auto,8,64,52,*,28,82,Auto,110,Auto" Height="40">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" MinWidth="0" Padding="0"
                                      VerticalAlignment="Center" ToolTip.Tip="Reverse proxy this service on this computer" />
                            <TextBlock Grid.Column="2" Text="{Binding RemoteText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Scheme}" FontSize="12"
                                       Foreground="{Binding SchemeAccent}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Soft}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="→" FontSize="12" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="6" Text="{Binding LocalPortText}" MinHeight="28" Padding="8,4"
                                     VerticalAlignment="Center" KeyDown="OnPortKeyDown"
                                     ToolTip.Tip="Local port on this computer" />
                            <Button Grid.Column="7" Classes="chip" Content="Apply" Margin="6,0,0,0"
                                    IsVisible="{Binding IsPortDirty}" Click="OnApplyPort" />
                            <TextBlock Grid.Column="8" Text="{Binding StateText}" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{Binding StateAccent}" VerticalAlignment="Center" />
                            <Button Grid.Column="9" Classes="quiet" Content="Open" IsEnabled="{Binding CanOpen}"
                                    Click="OnOpenMapping" ToolTip.Tip="{Binding Url}" />
                          </Grid>

                          <!-- Conflict: change the port or turn it off -->
                          <Grid ColumnDefinitions="*,Auto,Auto" Margin="22,0,0,8" IsVisible="{Binding HasProblem}">
                            <TextBlock Grid.Column="0" Text="{Binding Problem}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="chip" Content="Suggest free port" Margin="10,0,0,0"
                                    Click="OnSuggestPort" />
                            <Button Grid.Column="2" Classes="chip" Content="Turn off" Margin="6,0,0,0"
                                    Click="OnDisableMapping" />
                          </Grid>
                          <Border Classes="sep" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Log -->
    <Grid Grid.Row="4" RowDefinitions="Auto,*" Margin="24,16,24,0" Height="130">
      <TextBlock Grid.Row="0" Classes="k" Text="log" Margin="0,0,0,10" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <ItemsControl ItemsSource="{Binding Logs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:LogEntry">
              <Grid ColumnDefinitions="Auto,14,44,14,*" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{Binding Accent}" />
                <TextBlock Grid.Column="4" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Body}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="5" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,12,0,0">
      <TextBlock Classes="ui" FontSize="12.5" MaxWidth="820" Text="{Binding Hint}" />
    </Border>
  </Grid>
</Window>
